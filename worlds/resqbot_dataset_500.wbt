#VRML_SIM R2025a utf8

# ==============================================================================
# ResQBot AI — Post-Earthquake Multi-Hazard Urban Disaster Environment
# Target Simulator : Webots R2025a (Windows 11, optimized for RTX 3050 4 GB)
# Scope            : WORLD ONLY (No robot, no ROS, no controllers, no sensors)
# Coordinate System: ENU (+X East, +Y North, +Z Up)
# Zones            :
#   Zone A (Rescue_Entry)        : SW/South clear deployment staging & routes
#   Zone B (Residential_Collapse): W/NW partially collapsed residential building
#   Zone C (Severe_Collapse)     : E/SE severely pancaked commercial collapse
#   Zone D (Gas_Hazard_Zone)     : NE ruptured industrial gas pipeline & plume
#   Zone E (Fire_Damage_Zone)    : NW charred annex, localized fire & smoke
#   Zone F (Victim_01..05)       : 5 static articulated human victim Solids
# ==============================================================================

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/appearances/protos/Asphalt.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/appearances/protos/RoughConcrete.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/appearances/protos/Roughcast.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/appearances/protos/RedBricks.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/appearances/protos/CorrodedMetal.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/appearances/protos/CorrugatedMetal.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/appearances/protos/SandyGround.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/appearances/protos/StonePavement.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/appearances/protos/OldPlywood.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/appearances/protos/BrushedAluminium.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/appearances/protos/MetalPipePaint.proto"

EXTERNPROTO "../protos/ResQBotRover_DatasetSmoke.proto"

WorldInfo {
  info [
    "ResQBot AI — Post-Earthquake Multi-Hazard Urban Disaster Environment"
    "Webots R2025a static physical disaster world (no robot or controllers)."
    "Zones A-F: Rescue Entry, Residential Collapse, Severe Collapse, Gas Leak, Fire/Smoke, Static Victims."
  ]
  title "ResQBot AI - Automated YOLO11n Dataset Capture World"
  basicTimeStep 16
  defaultDamping Damping {
    linear 0.3
    angular 0.3
  }
}

Viewpoint {
  orientation -0.265 0.395 0.880 1.24
  position -26.5 -24.0 19.5
  followSmoothness 0.5
}

TexturedBackground {
  texture "noon_cloudy_empty"
}

TexturedBackgroundLight {
  texture "noon_cloudy_empty"
  castShadows TRUE
}

DEF Disaster_Site_Ground Group {
  children [
    DEF Disaster_Ground Solid {
      translation 0.0000 2.0000 -0.1000
      rotation 0.00000 0.00000 1.00000 0.00000
      children [
        Shape {
          appearance SandyGround {  textureTransform TextureTransform { scale 18.00 18.00 } }
          geometry DEF GEOM_DISASTER_GROUND_BASE Box { size 64.0000 60.0000 0.2000 }
